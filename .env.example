# Quasar loads `.env` for every mode, then `.env.prod` for production builds
# (later files win). So keep local-development defaults here in `.env`, and let
# `.env.prod` switch the API target for anything you ship.
#
#   .env       -> VITE_APP_MODE=local        (quasar dev)
#   .env.prod  -> VITE_APP_MODE=production   (quasar build)
#
# Mode -> backend base URL is mapped in src/helper/api/apiConfig.ts:
#   local      -> https://zcomus.test
#   production -> https://api.zcomus.site

VITE_APP_MODE=local

# Optional: overrides the mode mapping entirely. Useful for pointing at a
# local Laravel instance without changing the mode.
# VITE_API_URL=http://127.0.0.1:8000
