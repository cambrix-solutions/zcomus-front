# Loaded only for production builds (quasar build). Keeps `.env` free to hold
# local-development defaults.
VITE_APP_MODE=production

# api.zcomus.site does not accept connections yet, and requests to it stall
# until they time out. Keep this off until the backend is live, then flip it to
# `true` in the same commit that ships the working API.
VITE_USE_API=false
